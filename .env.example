# Discord application credentials (https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# For development: deploy commands to a specific guild (instant, no propagation delay).
# Leave empty to deploy commands globally (can take up to 1 hour to propagate).
GUILD_ID=your_development_guild_id_here

# Database file path (default: data/voice-clock.sqlite)
DB_PATH=data/voice-clock.sqlite

# Log level: debug | info | warn | error  (default: info)
LOG_LEVEL=info
